+		/*topbottom edge filter area when vertical*/
+		fts,edgefilter-top-ver-def = <0>;
+		fts,edgefilter-bottom-ver-def = <0>;
+		/*leftrigh edge filter area when horizontal*/
+		fts,edgefilter-leftrigt-hor-def = <20>;
+		/*topbottom edge filter area when horizontal*/
+		fts,edgefilter-top-hor-def = <48>;
+		fts,edgefilter-bottom-hor-def = <48>;
+		/*leftrigh edge filter area when vertical ingame*/
+		fts,edgefilter-leftrigt-ver-ingame = <48>;
+		/*topbottom edge filter area when vertical ingame*/
+		fts,edgefilter-top-ver-ingame = <0>;
+		fts,edgefilter-bottom-ver-ingame = <0>;
+		/*leftrigh edge filter area when horizontal ingame*/
+		fts,edgefilter-leftrigt-hor-ingame = <20>;
+		/*topbottom edge filter area when horizontal ingame*/
+		fts,edgefilter-top-hor-ingame = <48>;
+		fts,edgefilter-bottom-hor-ingame = <48>;
+		/*corner filter area when vertical in normal mode*/
+		fts,cornerfilter-x-ver-def = <150>;
+		fts,cornerfilter-y-ver-def = <300>;
+		/*corner filter area when horizontal in normal mode*/
+		fts,cornerfilter-x-hor-def = <170>;
+		fts,cornerfilter-y-hor-def = <170>;
+		/*corner filter area in game*/
+		fts,cornerfilter-area-step1 = <100>;
+		fts,cornerfilter-area-step2 = <170>;
+		fts,cornerfilter-area-step3 = <250>;
+		fts,cfg_0 {
+			fts,tp-vendor = <0x42>;
+			fts,tp-module = <1>;
+			fts,fw-name = "st_fts_j2_csot.ftb";
+			fts,limit-name = "stm_fts_production_limits_csot.csv";
+		};
+	};
+	goodix@5d {
+		compatible = "goodix,gt9889";
+		reg = <0x5d>;
+		status = "ok";
+		interrupt-parent = <&tlmm>;
+		interrupts = <39 0x2800>;
+		/*goodix,avdd_name = "vtouch";*/
+		/*goodix,vddio_name = "iotouch";*/
+		vtouch-supply = <&touch_vddio_vreg>;/*3.3v*/
+		iotouch-supply = <&pm8150a_l1>;
+		vtouch-load = <600000>;
+		pinctrl-names = "pmx_ts_active","pmx_ts_suspend";
+		pinctrl-0 = <&ts_active>;
+		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
+		goodix,reset-gpio = <&tlmm 38 0x0>;
