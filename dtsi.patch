+/*For J9A pinctrl overlay*/
+
+&tlmm {
+	tp_active: tp_active {
+		mux {
+				pins = "gpio4", "gpio5";
+				function = "gpio";
+		};
+
+		config {
+				pins = "gpio4", "gpio5";
+				drive-strength = <16>;
+				bias-pull-up;
+		};
+	};
+
+	tp_int_suspend: tp_int_suspend {
+		mux {
+				pins = "gpio5";
+				function = "gpio";
+		};
+		config {
+				pins = "gpio5";
+				drive-strength = <16>;
+				bias-pull-up;
+				input-enable;
+		};
+	};
+
+	tp_reset_suspend: tp_reset_suspend {
+		mux {
+				pins = "gpio4";
+				function = "gpio";
+		};
+		config {
+				pins = "gpio4";
+				drive-strength = <16>;
+				bias-disable;
+		};
+	};
+
+	camera_rear_micro_vdig_vio_ldo_en: camera_rear_micro_vdig_vio_ldo_en {
+		mux {
+			pins = "gpio122";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio122";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	camera_rear_tele_vio_ldo_en: camera_rear_tele_vio_ldo_en {
+		mux {
+			pins = "gpio125";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio125";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_wide_active: cam_sensor_wide_active {
+		/* RESET WIDE */
+		mux {
+			pins = "gpio29";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio29";
+			bias-disable; /* No PULL */
+			drive-strength = <2>; /* 2 MA */
+		};
+	};
+
+	cam_sensor_wide_suspend: cam_sensor_wide_suspend {
+		mux {
+			pins = "gpio29";
+			function = "gpio";
+		};
+
+		config {
+			pins = "gpio29";
+			bias-pull-down; /* PULL DOWN */
+			drive-strength = <2>; /* 2 MA */
+			output-low;
+		};
+	};
+
+	cam_sensor_front_active: cam_sensor_front_active {
+		/* RESET FRONT */
+		mux {
+			pins = "gpio32";
+			function = "gpio";
+		};
+
+		config {
