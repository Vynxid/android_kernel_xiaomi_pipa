+
+&sde_dsi_suspend {
+        mux {
+                pins = "gpio12", "gpio50";
+                function = "gpio";
+        };
+
+        config {
+                pins = "gpio12", "gpio50";
+                drive-strength = <2>;   /* 2 mA */
+                bias-pull-down;                 /* PULL DOWN */
+        };
+};
